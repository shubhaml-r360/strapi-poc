{
  "kind": "collectionType",
  "collectionName": "complaints",
  "info": {
    "singularName": "complaint",
    "pluralName": "complaints",
    "displayName": "Complaint"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "uuid": {
      "type": "string",
      "unique": true,
      "configurable": false
    },
    "ref": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "title": {
      "type": "string"
    },
    "severity": {
      "type": "enumeration",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "stage": {
      "type": "enumeration",
      "enum": [
        "received",
        "investigating",
        "stance_proposed",
        "resolved_awaiting_signoff",
        "closed"
      ]
    },
    "channel": {
      "type": "enumeration",
      "enum": [
        "phone",
        "email",
        "whatsapp"
      ]
    },
    "verbatim": {
      "type": "text"
    },
    "escalationRung": {
      "type": "integer",
      "min": 1,
      "max": 3
    },
    "receivedAt": {
      "type": "datetime"
    },
    "dueAt": {
      "type": "datetime"
    },
    "rootCause": {
      "type": "string"
    },
    "bankReviewRequired": {
      "type": "boolean",
      "default": false
    },
    "closedAt": {
      "type": "datetime"
    },
    "member": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::member.member"
    },
    "request": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::request.request",
      "mappedBy": "complaint"
    },
    "owner": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::agent.agent"
    }
  }
}
